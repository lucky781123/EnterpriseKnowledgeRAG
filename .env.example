# 复制为本地未提交的 .env 文件后填写。不要把真实密钥写入仓库。

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL 是业务事实源；migration 由部署 init container 执行，API readiness 只检查版本。
POSTGRES_DSN=
POSTGRES_POOL_SIZE=3
POSTGRES_MAX_OVERFLOW=2
POSTGRES_POOL_TIMEOUT_SECONDS=10
POSTGRES_POOL_RECYCLE_SECONDS=1800
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_LOCK_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=

# Weaviate：默认只启动本地依赖，不切换 API 的 PostgreSQL 默认读取路径。
WEAVIATE_ENABLED=false
WEAVIATE_BASE_URL=http://127.0.0.1:8080
WEAVIATE_API_KEY=
WEAVIATE_SCHEMA_VERSION=dense-v1

# 仅供本地 development 产品闭环使用；请在未跟踪的 .env 中生成至少 32 字节随机值。
DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
DEV_AUTH_TOKEN_TTL_SECONDS=3600
WEAVIATE_PORT=8080

# Object storage: 首期可使用本地适配器；接入 S3 兼容实现时填写
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_ROOT=./var/object-storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=enterprise-rag

# Keycloak / OIDC
OIDC_ISSUER_URL=http://localhost:8081/realms/rag
OIDC_AUDIENCE=rag-api
OIDC_CLIENT_ID=rag-api

# Local LLM: LM Studio OpenAI-compatible endpoint
# LM Studio 服务根地址；Provider 适配层负责拼接 /v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
LOCAL_LLM_MAX_CONCURRENCY=2

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=hardcore_aryabhata_598/qwen3-embedding:8b
OLLAMA_RERANKER_MODEL=

# Optional online provider. Never commit the value; default is disabled.
GROK_API_KEY=
GROK_BASE_URL=https://api.deepspacecode.chat/v1
GROK_MODEL=grok-4.6
ONLINE_LLM_ENABLED=false

# Evaluation / execution
RAG_DATASET_PATH=docs/evaluation/dataset-draft.jsonl
RAG_ENV=local
RAG_RUN_ID=
