# 配置基础模板：本阶段不会由旧 factory 自动读取或连接这些服务。
# 功能默认关闭；不要把此文件改成携带凭据的已提交配置。
RAG_INFRA_ENABLED=false
RAG_CELERY_ENABLED=false
# 两个独立实例；生产使用 rediss:// 并保持证书验证。
REDIS_CACHE_URL=
REDIS_COORDINATION_URL=
# broker 取 REDIS_COORDINATION_URL，backend 使用同一协调实例的独立 namespace。
CELERY_RESULT_BACKEND=
EMBEDDING_CACHE_TTL_SECONDS=86400
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_RESULT_TTL_SECONDS=86400

# 生产选 s3 并提供托管 MinIO；开发保留 local，不自动切换或搬移旧原文。
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=rag
# 入库专用实例必须与查询实例拥有相同模型/profile；不默认共享查询资源。
INGESTION_OLLAMA_BASE_URL=

# DeepSeek 唯一配置入口：config/deepseek.toml；key 放 .local/secrets/deepseek-api-key.txt。
# 不使用另一个同名环境变量入口，避免配置写了却未生效。
# Worker 每阶段重读 config/worker-identities.toml（development，非生产身份）。
# 托管 Weaviate 必须授权原生 backup backend，否则备份执行失败。
WEAVIATE_BACKUP_BACKEND=s3
