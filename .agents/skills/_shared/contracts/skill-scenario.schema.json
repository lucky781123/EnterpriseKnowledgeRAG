{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-rag.local/contracts/skill-scenario.schema.json",
  "title": "SkillPressureScenarios",
  "description": "用于验证 Skill 决策质量的压力场景集合。",
  "type": "array",
  "minItems": 4,
  "items": {
    "type": "object",
    "required": ["id", "skill", "category", "request", "setup", "expected_decisions", "required_invariants", "forbidden_actions", "verification"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
      "skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
      "category": {"enum": ["happy_path", "boundary", "failure", "security"]},
      "request": {"type": "string", "minLength": 12},
      "setup": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
      "expected_decisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
      "required_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
      "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
      "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
    },
    "additionalProperties": false
  }
}
