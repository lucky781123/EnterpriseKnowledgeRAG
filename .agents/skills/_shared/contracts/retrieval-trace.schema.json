{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-rag.local/contracts/retrieval-trace.schema.json",
  "title": "RetrievalTrace",
  "description": "记录查询转换、召回、融合、重排和上下文组装的可审计结果。",
  "type": "object",
  "required": ["request_id", "tenant_id", "query_hash", "retrieval_mode", "stages", "candidates", "selected_chunk_ids"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "query_hash": {"type": "string", "minLength": 1},
    "retrieval_mode": {"enum": ["dense", "sparse", "hybrid", "metadata", "degraded"]},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "duration_ms", "input_count", "output_count"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["success", "partial", "failure", "skipped"]},
          "duration_ms": {"type": "number", "minimum": 0},
          "input_count": {"type": "integer", "minimum": 0},
          "output_count": {"type": "integer", "minimum": 0},
          "failure_kind": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "version_id", "chunk_id", "source_id", "authorization_checked", "scores"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "version_id": {"type": "string", "minLength": 1},
          "chunk_id": {"type": "string", "minLength": 1},
          "parent_id": {"type": ["string", "null"]},
          "source_id": {"type": "string", "minLength": 1},
          "authorization_checked": {"const": true},
          "scores": {"type": "object", "additionalProperties": {"type": "number"}}
        },
        "additionalProperties": false
      }
    },
    "selected_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "index_version": {"type": ["string", "null"]},
    "degradation_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
